@page "/"
@using MermaidSharp.Samples

<PageTitle>MermaidSharp samples</PageTitle>

<h1>MermaidSharp samples</h1>
<p class="lead">Every diagram below is generated in C# with MermaidSharp and rendered with Blazorade.Mermaid.</p>

<nav class="mb-4">
    @foreach (var group in DiagramCatalog.ByKind)
    {
        <a class="btn btn-outline-secondary btn-sm me-1 mb-1" href="#@group.Key">@group.First().Category</a>
    }
</nav>

@foreach (var group in DiagramCatalog.ByKind)
{
    <section id="@group.Key" class="mb-5">
        <h2 class="border-bottom pb-2">@group.First().Category</h2>
        @foreach (var example in group)
        {
            <article id="@example.Id" class="card mb-4">
                <div class="card-body">
                    <h3 class="h5 card-title">@example.Title</h3>
                    <p class="card-text text-muted">@example.Description</p>
                    <MermaidDiagram Definition="@example.Definition" />
                    <details>
                        <summary>Mermaid definition</summary>
                        <pre class="bg-light p-2 border rounded"><code>@example.Definition</code></pre>
                    </details>
                </div>
            </article>
        }
    </section>
}
