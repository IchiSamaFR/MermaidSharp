# Normalize line endings: LF in the repository, native line endings in the working tree.
* text=auto

# Windows-oriented files keep CRLF on every platform.
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.sln       text eol=crlf
*.slnx      text eol=crlf
*.razor     text eol=crlf
*.cshtml    text eol=crlf
*.config    text eol=crlf

# Unix-oriented files keep LF on every platform.
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binary files.
*.png       binary
*.ico       binary
*.jpg       binary
*.dll       binary
*.nupkg     binary
*.snk       binary
